# ============================================================
#  Variables de entorno - Stack Flota
#  Copia este archivo a .env y ajusta los valores según tu entorno
# ============================================================

# ── Base de Datos ─────────────────────────────────────────────
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=flota_docs_db

# ── MinIO / S3 ────────────────────────────────────────────────
S3_ACCESS_KEY=admin_flota
S3_SECRET_KEY=
S3_BUCKET_NAME=flota-docs
# URL pública para acceso desde el navegador (fuera de Docker)
S3_EXTERNAL_ENDPOINT=http://localhost:9000

# ── Authentik (Backend internal endpoint) ─────────────────────
# URL para que el backend descubra la configuración OIDC de Authentik
OIDC_DISCOVERY_URL=http://server:9000/application/o/flota-docs/

# ── LangSmith / LangChain (Tracing) ──────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lock_flota
LANGCHAIN_TRACING_V2=true

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=

# ── Frontend / Authentik (Vite build-time vars) ───────────────
VITE_AUTHENTIK_AUTHORITY=http://localhost:9080/application/o/flota-docs/
VITE_AUTHENTIK_CLIENT_ID=
VITE_AUTHENTIK_REDIRECT_URI=http://localhost:8001
